{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "K65 Plus Wireless Color Settings",
  "version": "0.1.0",
  "identifier": "io.github.dascoco0811.k65-plus-wireless-color-settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "K65 Plus Wireless Color Settings",
        "width": 1120,
        "height": 860,
        "minWidth": 900,
        "minHeight": 680,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "Utility",
    "shortDescription": "Reactive per-key lighting for the Corsair K65 PLUS WIRELESS",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
